<!-- Zeno Machine Dashboard Tab (Cloud-Hypervisor MicroVM) -->
<div class="viewport" id="tab-machines">
    <div class="content-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <div>
            <h2 style="font-size: 1.5rem; font-weight: 600; color: var(--text-main); margin: 0; display: flex; align-items: center; gap: 10px;">
                <i class="fa-solid fa-server" style="color: var(--accent-primary);"></i> Zeno Machine
            </h2>
            <p style="font-size: 0.85rem; color: var(--text-muted); margin: 4px 0 0 0;">
                Next-Gen Hardware-Isolated MicroVM Engine berbasis Cloud-Hypervisor & Rust (Kecepatan Boot &lt; 100ms)
            </p>
        </div>
        <div style="display: flex; gap: 10px;">
            <button class="btn btn-secondary" onclick="openIsoLibraryModal()" style="display: flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-compact-disc" style="color: #ec4899;"></i> ISO Library
            </button>
            <button class="btn btn-primary" onclick="openCreateMachineModal()" style="display: flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-plus"></i> New Zeno Machine
            </button>
            <button class="btn btn-secondary" onclick="loadZenoMachines()" title="Refresh List">
                <i class="fa-solid fa-rotate-right"></i>
            </button>
        </div>
    </div>

    <!-- Incoming Live Migration Handshake Approval Banner Container -->
    <div id="pending-migration-container" style="margin-bottom: 20px;"></div>

    <!-- Quick Stats Header -->

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 15px; margin-bottom: 25px;">
        <div style="background: rgba(30, 41, 59, 0.5); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 16px;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; font-weight: 600;">Total Machines</span>
                <i class="fa-solid fa-microchip" style="color: var(--accent-primary); font-size: 1.2rem;"></i>
            </div>
            <div id="stat-total-machines" style="font-size: 1.6rem; font-weight: 700; color: var(--text-main); margin-top: 8px;">0</div>
        </div>
        <div style="background: rgba(30, 41, 59, 0.5); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 16px;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; font-weight: 600;">Active Running</span>
                <i class="fa-solid fa-circle-play" style="color: #10b981; font-size: 1.2rem;"></i>
            </div>
            <div id="stat-running-machines" style="font-size: 1.6rem; font-weight: 700; color: #10b981; margin-top: 8px;">0</div>
        </div>
        <div style="background: rgba(30, 41, 59, 0.5); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 16px;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; font-weight: 600;">Allocated vCPUs</span>
                <i class="fa-solid fa-cpu" style="color: #f59e0b; font-size: 1.2rem;"></i>
            </div>
            <div id="stat-allocated-vcpus" style="font-size: 1.6rem; font-weight: 700; color: #f59e0b; margin-top: 8px;">0 Cores</div>
        </div>
        <div style="background: rgba(30, 41, 59, 0.5); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 16px;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; font-weight: 600;">Allocated RAM</span>
                <i class="fa-solid fa-memory" style="color: #8b5cf6; font-size: 1.2rem;"></i>
            </div>
            <div id="stat-allocated-ram" style="font-size: 1.6rem; font-weight: 700; color: #8b5cf6; margin-top: 8px;">0 MB</div>
        </div>
    </div>

    <!-- Zeno Machines Table Container -->
    <div style="background: rgba(30, 41, 59, 0.5); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; overflow: hidden;">
        <div style="padding: 16px 20px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); display: flex; justify-content: space-between; align-items: center;">
            <h3 style="margin: 0; font-size: 1rem; font-weight: 600; color: var(--text-main);">Registered Zeno Machines</h3>
            <span style="font-size: 0.78rem; color: var(--text-muted);">Cloud-Hypervisor Socket Manager Active</span>
        </div>
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.85rem;">
                <thead>
                    <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.08); background: rgba(15, 23, 42, 0.4); color: var(--text-muted);">
                        <th style="padding: 12px 20px;">Name</th>
                        <th style="padding: 12px 16px;">OS Presets</th>
                        <th style="padding: 12px 16px;">Specs (vCPU / RAM)</th>
                        <th style="padding: 12px 16px;">Storage (Disk)</th>
                        <th style="padding: 12px 16px;">Status</th>
                        <th style="padding: 12px 16px;">Usage History</th>
                        <th style="padding: 12px 20px; text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody id="machines-table-body">
                    <tr>
                        <td colspan="7" style="padding: 30px; text-align: center; color: var(--text-muted);">
                            <i class="fa-solid fa-circle-notch fa-spin" style="font-size: 1.5rem; margin-bottom: 8px;"></i>
                            <div>Loading Zeno Machines...</div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal Create Zeno Machine -->
    <div id="create-machine-modal" class="modal-backdrop" style="display: none;">
        <div class="modal-content" style="max-width: 540px; background: #0f172a; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; padding: 24px; color: var(--text-main);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h3 style="margin: 0; font-size: 1.2rem; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                    <i class="fa-solid fa-server" style="color: var(--accent-primary);"></i> Create New Zeno Machine
                </h3>
                <button onclick="closeCreateMachineModal()" style="background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 1.1rem;">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <form onsubmit="event.preventDefault(); submitCreateMachine();">
                <div class="form-group" style="margin-bottom: 16px;">
                    <label style="display: block; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 6px; font-weight: 500;">Machine Name</label>
                    <input type="text" id="machine-name-input" placeholder="e.g. app-vm-01" required style="width: 100%; padding: 10px 12px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.12); background: rgba(30, 41, 59, 0.7); color: var(--text-main); font-size: 0.88rem;">
                    <span style="display: block; font-size: 0.72rem; color: #10b981; margin-top: 4px;"><i class="fa-solid fa-circle-info"></i> DNS Internal: Mesin ini otomatis dapat diakses via <strong>[nama].zeno</strong></span>
                </div>
                <div class="form-group" style="margin-bottom: 16px;">
                    <label style="display: block; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 6px; font-weight: 500;">OS Type / Preset</label>
                    <select id="machine-os-input" style="width: 100%; padding: 10px 12px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.12); background: rgba(30, 41, 59, 0.7); color: var(--text-main); font-size: 0.88rem; cursor: pointer;">
                        <option value="linux">🐧 Linux (Ubuntu / Alpine / Debian MicroVM)</option>
                        <option value="windows">🪟 Windows (Windows 11 / Server Guest OS)</option>
                    </select>
                </div>
                <div class="form-group" style="margin-bottom: 16px;">
                    <label style="display: block; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 6px; font-weight: 500;">Boot Source</label>
                    <div style="display: flex; gap: 15px; margin-bottom: 10px;">
                        <label style="display: flex; align-items: center; gap: 6px; font-size: 0.82rem; color: var(--text-main); cursor: pointer;">
                            <input type="radio" name="machine-boot-source-type" value="iso" checked onchange="window.toggleBootSource('iso')" style="cursor: pointer;"> ISO Image
                        </label>
                        <label style="display: flex; align-items: center; gap: 6px; font-size: 0.82rem; color: var(--text-main); cursor: pointer;">
                            <input type="radio" name="machine-boot-source-type" value="oci" onchange="window.toggleBootSource('oci')" style="cursor: pointer;"> OCI Container (Zeno Box)
                        </label>
                    </div>

                    <div id="machine-boot-source-iso-wrapper">
                        <select id="machine-iso-input" style="width: 100%; padding: 10px 12px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.12); background: rgba(30, 41, 59, 0.7); color: var(--text-main); font-size: 0.88rem; cursor: pointer;">
                            <option value="">-- No ISO Attached (Standard Boot) --</option>
                        </select>
                    </div>

                    <div id="machine-boot-source-oci-wrapper" style="display: none;">
                        <div style="position: relative; margin-bottom: 8px;">
                            <div style="display: flex; gap: 8px; align-items: center;">
                                <div style="flex: 1; position: relative;">
                                    <input type="text" id="machine-oci-image-input" autocomplete="off" placeholder="Ketik nama image, misalnya: ubuntu, nginx, alpine..." oninput="window.onOciImageSearch(this.value)" onfocus="window.onOciImageSearch(this.value)" style="width: 100%; box-sizing: border-box; padding: 10px 36px 10px 12px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.12); background: rgba(30, 41, 59, 0.7); color: var(--text-main); font-size: 0.88rem; font-family: var(--font-code);">
                                    <i id="machine-oci-search-icon" class="fa-brands fa-docker" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); color: #2496ed; font-size: 1rem; opacity: 0.6;"></i>
                                </div>
                            </div>
                            <div id="machine-oci-autocomplete" style="display: none; position: absolute; left: 0; right: 0; top: 100%; z-index: 999; max-height: 260px; overflow-y: auto; background: #1a2236; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 0 0 8px 8px; box-shadow: 0 8px 24px rgba(0,0,0,0.5);"></div>
                        </div>
                        <div id="machine-oci-cached-images" style="margin-bottom: 6px;">
                            <button type="button" class="btn-action" onclick="window.loadCachedOciImages()" style="font-size: 0.75rem; padding: 4px 10px;"><i class="fa-solid fa-layer-group"></i> Load cached images from Zeno Box</button>
                        </div>
                        <div style="font-size: 0.72rem; color: var(--text-muted); line-height: 1.5;">
                            <i class="fa-solid fa-info-circle" style="color: var(--accent-primary);"></i>
                            ZenoPanel akan pull image OCI, mengekstrak rootfs-nya ke disk VM, dan melakukan boot MicroVM langsung dari rootfs tersebut (tanpa ISO).
                            <br><i class="fa-brands fa-docker" style="color: #2496ed;"></i> Ketik di atas untuk mencari image langsung dari Docker Hub.
                        </div>
                    </div>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px;">
                    <div class="form-group">
                        <label style="display: block; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 6px; font-weight: 500;">vCPU Cores</label>
                        <input type="number" id="machine-vcpu-input" value="2" min="1" max="64" style="width: 100%; padding: 10px 12px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.12); background: rgba(30, 41, 59, 0.7); color: var(--text-main); font-size: 0.88rem;">
                    </div>
                    <div class="form-group">
                        <label style="display: block; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 6px; font-weight: 500;">Memory (RAM in MB)</label>
                        <input type="number" id="machine-ram-input" value="1024" min="128" step="128" style="width: 100%; padding: 10px 12px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.12); background: rgba(30, 41, 59, 0.7); color: var(--text-main); font-size: 0.88rem;">
                    </div>
                </div>
                <div class="form-group" style="margin-bottom: 16px;">
                    <label style="display: block; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 6px; font-weight: 500;">Disk Size (GB)</label>
                    <input type="number" id="machine-disk-input" value="10" min="2" max="2000" style="width: 100%; padding: 10px 12px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.12); background: rgba(30, 41, 59, 0.7); color: var(--text-main); font-size: 0.88rem;">
                </div>
                <div class="form-group" style="margin-bottom: 16px;">
                    <label style="display: block; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 6px; font-weight: 500;">SSH Public Key (Cloud-Init Auto Inject)</label>
                    <textarea id="machine-ssh-key-input" rows="2" placeholder="e.g. ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... user&#64;host" style="width: 100%; padding: 10px 12px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.12); background: rgba(30, 41, 59, 0.7); color: var(--text-main); font-size: 0.82rem; font-family: var(--font-code); resize: vertical;"></textarea>
                </div>
                <div class="form-group" style="margin-bottom: 20px;">
                    <label style="display: block; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 6px; font-weight: 500;">Root / Initial User Password (Optional)</label>
                    <input type="password" id="machine-password-input" placeholder="Set default password for MicroVM" style="width: 100%; padding: 10px 12px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.12); background: rgba(30, 41, 59, 0.7); color: var(--text-main); font-size: 0.88rem;">
                </div>
                <div style="display: flex; justify-content: flex-end; gap: 10px;">
                    <button type="button" class="btn btn-secondary" onclick="closeCreateMachineModal()">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Zeno Machine</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal Live Resize (Dynamic RAM & vCPU) -->
    <div id="resize-machine-modal" class="modal-backdrop" style="display: none;">
        <div class="modal-content" style="max-width: 480px; background: #0f172a; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; padding: 24px; color: var(--text-main);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h3 style="margin: 0; font-size: 1.1rem; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                    <i class="fa-solid fa-sliders" style="color: #f59e0b;"></i> Live Resize: <span id="resize-target-name">Machine</span>
                </h3>
                <button onclick="closeResizeMachineModal()" style="background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 1.1rem;">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <form onsubmit="event.preventDefault(); submitResizeMachine();">
                <input type="hidden" id="resize-machine-name">
                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; margin-bottom: 20px;">
                    <div class="form-group">
                        <label style="display: block; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 6px; font-weight: 500;">vCPU Cores</label>
                        <input type="number" id="resize-vcpu-input" min="1" max="64" style="width: 100%; padding: 10px 12px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.12); background: rgba(30, 41, 59, 0.7); color: var(--text-main); font-size: 0.88rem;">
                    </div>
                    <div class="form-group">
                        <label style="display: block; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 6px; font-weight: 500;">RAM (MB)</label>
                        <input type="number" id="resize-ram-input" min="128" step="128" style="width: 100%; padding: 10px 12px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.12); background: rgba(30, 41, 59, 0.7); color: var(--text-main); font-size: 0.88rem;">
                    </div>
                    <div class="form-group">
                        <label style="display: block; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 6px; font-weight: 500;">Disk (GB)</label>
                        <input type="number" id="resize-disk-input" min="1" max="10000" style="width: 100%; padding: 10px 12px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.12); background: rgba(30, 41, 59, 0.7); color: var(--text-main); font-size: 0.88rem;">
                    </div>
                </div>
                <div style="font-size: 0.78rem; color: #10b981; background: rgba(16, 185, 129, 0.1); padding: 10px; border-radius: 6px; margin-bottom: 20px;">
                    <i class="fa-solid fa-bolt"></i> <strong>Live Hot-Plug Active:</strong> Perubahan RAM & vCPU akan langsung diterapkan secara real-time tanpa me-reboot VM!
                </div>
                <div style="display: flex; justify-content: flex-end; gap: 10px;">
                    <button type="button" class="btn btn-secondary" onclick="closeResizeMachineModal()">Cancel</button>
                    <button type="submit" class="btn btn-primary">Apply Live Resize</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal Live Migration Zeno Machine (dengan Pre-flight Check & Progress) -->
    <div id="migrate-machine-modal" class="modal-backdrop" style="display: none; align-items: center; justify-content: center;">
        <div class="modal-content" style="max-width: 560px; width: 100%; background: #0f172a; border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 28px; color: var(--text-main);">

            <!-- Header -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 22px;">
                <h3 style="margin: 0; font-size: 1.1rem; font-weight: 700; display: flex; align-items: center; gap: 8px;">
                    <i class="fa-solid fa-arrows-rotate" style="color: #8b5cf6;"></i>
                    Live Migration: <span id="migrate-target-name" style="color: #8b5cf6;">Machine</span>
                </h3>
                <button id="migrate-machine-close-btn" onclick="closeMigrateMachineModal()" style="background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 1.2rem;">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <input type="hidden" id="migrate-machine-name">

            <!-- STEP 1: Input & Preflight -->
            <div id="migrate-machine-step-input">
                <div class="form-group" style="margin-bottom: 14px;">
                    <label style="display: block; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 6px; font-weight: 500;">Target Node / Host IP</label>
                    <input type="text" id="migrate-host-input" placeholder="e.g. 192.168.1.150" style="width: 100%; padding: 10px 12px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.12); background: rgba(30,41,59,0.7); color: var(--text-main); font-size: 0.88rem; box-sizing: border-box;">
                </div>
                <div class="form-group" style="margin-bottom: 20px;">
                    <label style="display: block; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 6px; font-weight: 500;">Target Port</label>
                    <input type="number" id="migrate-port-input" value="8080" style="width: 100%; padding: 10px 12px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.12); background: rgba(30,41,59,0.7); color: var(--text-main); font-size: 0.88rem; box-sizing: border-box;">
                </div>

                <!-- Preflight Result Panel -->
                <div id="migrate-machine-preflight-result" style="display: none; margin-bottom: 18px; border-radius: 10px; overflow: hidden; border: 1px solid rgba(255,255,255,0.08);">
                    <div style="background: rgba(15,23,42,0.8); padding: 12px 16px; font-size: 0.82rem; display: flex; flex-direction: column; gap: 8px;">
                        <div id="pf-machine-reach" style="display: flex; align-items: center; gap: 8px;"><i class="fa-solid fa-spinner fa-spin" style="color:#8b5cf6; width:14px;"></i> Memeriksa konektivitas ke target...</div>
                        <div id="pf-machine-latency" style="display: flex; align-items: center; gap: 8px;"><i class="fa-solid fa-spinner fa-spin" style="color:#8b5cf6; width:14px;"></i> Mengukur latensi jaringan...</div>
                        <div id="pf-machine-ram" style="display: flex; align-items: center; gap: 8px;"><i class="fa-solid fa-spinner fa-spin" style="color:#8b5cf6; width:14px;"></i> Verifikasi ketersediaan RAM...</div>
                    </div>
                </div>

                <div style="display: flex; justify-content: space-between; gap: 10px;">
                    <button type="button" onclick="runMachinePreflight()" id="btn-machine-preflight" style="flex: 1; padding: 10px; border-radius: 6px; border: 1px solid rgba(139,92,246,0.4); background: rgba(139,92,246,0.1); color: #8b5cf6; cursor: pointer; font-weight: 600; font-size: 0.88rem;">
                        <i class="fa-solid fa-stethoscope"></i> Run Pre-flight Check
                    </button>
                    <button type="button" onclick="submitMigrateMachine()" id="btn-machine-migrate-start" disabled style="flex: 1; padding: 10px; border-radius: 6px; border: 1px solid rgba(139,92,246,0.4); background: rgba(139,92,246,0.15); color: rgba(139,92,246,0.4); cursor: not-allowed; font-weight: 600; font-size: 0.88rem;">
                        <i class="fa-solid fa-play"></i> Start Migration
                    </button>
                </div>
            </div>

            <!-- STEP 2: Live Progress Panel (Source HOST A) -->
            <div id="migrate-machine-step-progress" style="display: none;">
                <div style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 14px; text-align: center;">
                    <i class="fa-solid fa-arrows-rotate fa-spin" style="color: #8b5cf6;"></i>
                    Live Migration sedang berlangsung...
                </div>

                <!-- Source Host Progress -->
                <div style="background: rgba(30,41,59,0.6); border: 1px solid rgba(255,255,255,0.07); border-radius: 10px; padding: 14px; margin-bottom: 12px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                        <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted);">
                            <i class="fa-solid fa-server" style="color: #f59e0b;"></i> HOST A (Server Ini) — SOURCE
                        </span>
                        <span id="machine-src-percent" style="font-size: 0.85rem; font-weight: 700; color: #f59e0b;">0%</span>
                    </div>
                    <div style="background: rgba(255,255,255,0.06); border-radius: 20px; height: 8px; overflow: hidden;">
                        <div id="machine-src-bar" style="height: 100%; width: 0%; background: linear-gradient(90deg, #f59e0b, #fbbf24); border-radius: 20px; transition: width 0.4s ease;"></div>
                    </div>
                    <div id="machine-src-phase" style="font-size: 0.75rem; color: var(--text-muted); margin-top: 6px;">Menginisialisasi checkpoint...</div>
                </div>

                <!-- Target Host Progress -->
                <div style="background: rgba(30,41,59,0.6); border: 1px solid rgba(255,255,255,0.07); border-radius: 10px; padding: 14px; margin-bottom: 16px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                        <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted);">
                            <i class="fa-solid fa-server" style="color: #10b981;"></i> HOST B (<span id="machine-dst-host-label">Target</span>) — DESTINATION
                        </span>
                        <span id="machine-dst-percent" style="font-size: 0.85rem; font-weight: 700; color: #10b981;">0%</span>
                    </div>
                    <div style="background: rgba(255,255,255,0.06); border-radius: 20px; height: 8px; overflow: hidden;">
                        <div id="machine-dst-bar" style="height: 100%; width: 0%; background: linear-gradient(90deg, #10b981, #34d399); border-radius: 20px; transition: width 0.4s ease;"></div>
                    </div>
                    <div id="machine-dst-phase" style="font-size: 0.75rem; color: var(--text-muted); margin-top: 6px;">Menunggu sinyal dari sumber...</div>
                </div>

                <!-- Status akhir -->
                <div id="machine-migration-done" style="display: none; text-align: center; padding: 12px; background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.3); border-radius: 8px; color: #10b981; font-weight: 600; margin-bottom: 14px;">
                    <i class="fa-solid fa-circle-check"></i> Live Migration Berhasil! VM aktif di HOST B.
                </div>
                <div id="machine-migration-fail" style="display: none; text-align: center; padding: 12px; background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); border-radius: 8px; color: #ef4444; font-weight: 600; margin-bottom: 14px;">
                    <i class="fa-solid fa-triangle-exclamation"></i> Migration Gagal — VM tetap berjalan di HOST A (Rollback Otomatis).
                </div>

                <div style="text-align: right;">
                    <button onclick="closeMigrateMachineModal()" style="padding: 8px 20px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.12); background: transparent; color: var(--text-muted); cursor: pointer;">Tutup</button>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Modal Web Serial Console (xterm.js Terminal) -->
<div id="machine-console-modal" class="modal-backdrop" style="display: none; align-items: center; justify-content: center;">
    <div class="modal-content" style="max-width: 840px; width: 95%; background: #090d16; border: 1px solid rgba(59, 130, 246, 0.25); border-radius: 14px; padding: 20px; color: var(--text-main); display: flex; flex-direction: column; height: 520px; box-shadow: 0 20px 50px rgba(0,0,0,0.7);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; padding-bottom: 10px; border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
            <h3 style="margin: 0; font-size: 1.05rem; font-weight: 600; display: flex; align-items: center; gap: 8px; color: var(--accent-primary);">
                <i class="fa-solid fa-terminal"></i> Interactive Web Serial Console: <span id="machine-console-title" style="color: #fff;">Machine</span>
            </h3>
            <div style="display: flex; items-center: center; gap: 10px;">
                <span class="badge" style="font-size: 0.72rem; padding: 3px 8px; background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 20px;">TTY Connected</span>
                <button onclick="closeMachineConsoleModal()" style="background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 1.2rem;">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        </div>
        <div id="machine-console-container" style="flex-grow: 1; background: #05070c; border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.05); padding: 12px; overflow: hidden; position: relative;">
            <div id="machine-console-terminal" style="width: 100%; height: 100%; box-sizing: border-box;"></div>
        </div>
        <div style="margin-top: 12px; display: flex; justify-content: space-between; align-items: center; font-size: 0.78rem; color: var(--text-muted);">
            <span>Interactive microVM Serial Terminal Console (xterm.js)</span>
            <button onclick="closeMachineConsoleModal()" class="btn btn-secondary btn-sm">Close Console</button>
        </div>
    </div>
</div>

<!-- Modal Zeno Machine Boot Log Viewer -->
<div id="machine-boot-log-modal" class="modal-backdrop" style="display: none; align-items: center; justify-content: center;">
    <div class="modal-content" style="max-width: 800px; width: 95%; background: #090d16; border: 1px solid rgba(16, 185, 129, 0.25); border-radius: 14px; padding: 20px; color: var(--text-main); display: flex; flex-direction: column; height: 500px; box-shadow: 0 20px 50px rgba(0,0,0,0.7);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; padding-bottom: 10px; border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
            <h3 style="margin: 0; font-size: 1.05rem; font-weight: 600; display: flex; align-items: center; gap: 8px; color: #10b981;">
                <i class="fa-solid fa-clock-rotate-left"></i> Historical Boot Log: <span id="machine-boot-log-title" style="color: #fff;">Machine</span>
            </h3>
            <button onclick="closeMachineBootLogModal()" style="background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 1.2rem;">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div style="flex-grow: 1; display: flex; flex-direction: column; background: #05070c; border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.05); padding: 4px; overflow: hidden;">
            <textarea id="machine-boot-log-content" readonly style="width: 100%; height: 100%; background: transparent; border: none; outline: none; color: #a3e635; font-family: 'Courier New', Courier, monospace; font-size: 0.82rem; resize: none; padding: 12px; box-sizing: border-box; line-height: 1.4; overflow-y: auto;"></textarea>
        </div>
        <div style="margin-top: 12px; display: flex; justify-content: space-between; align-items: center; font-size: 0.78rem; color: var(--text-muted);">
            <span>ReadOnly logs from serial console (/var/log/zeno-machine)</span>
            <button onclick="closeMachineBootLogModal()" class="btn btn-secondary btn-sm">Close Logs</button>
        </div>
    </div>
</div>

<!-- Modal Expose Zeno Machine via Reverse Proxy -->
<div id="machine-proxy-modal" class="modal-backdrop" style="display: none; align-items: center; justify-content: center;">
    <div class="modal-content" style="max-width: 480px; width: 100%; background: #0f172a; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; padding: 24px; color: var(--text-main);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h3 style="margin: 0; font-size: 1.1rem; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-network-wired" style="color: var(--accent-primary);"></i> 1-Click Expose via Reverse Proxy
            </h3>
            <button onclick="closeMachineProxyModal()" style="background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 1.1rem;">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <form onsubmit="event.preventDefault(); submitMachineProxy();">
            <input type="hidden" id="machine-proxy-name">
            <div class="form-group" style="margin-bottom: 16px;">
                <label style="display: block; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 6px; font-weight: 500;">Domain / Hostname</label>
                <input type="text" id="machine-proxy-domain" placeholder="e.g. vm.example.com" required style="width: 100%; padding: 10px 12px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.12); background: rgba(30, 41, 59, 0.7); color: var(--text-main); font-size: 0.88rem;">
            </div>
            <div class="form-group" style="margin-bottom: 20px;">
                <label style="display: block; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 6px; font-weight: 500;">Target Port in Guest MicroVM</label>
                <input type="number" id="machine-proxy-port" value="80" min="1" max="65535" style="width: 100%; padding: 10px 12px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.12); background: rgba(30, 41, 59, 0.7); color: var(--text-main); font-size: 0.88rem;">
            </div>
            <div style="font-size: 0.78rem; color: var(--text-muted); background: rgba(59, 130, 246, 0.08); padding: 10px; border-radius: 6px; margin-bottom: 20px; border: 1px solid rgba(59, 130, 246, 0.15);">
                <i class="fa-solid fa-circle-info" style="color: var(--accent-primary);"></i> ZenoPanel akan otomatis menambahkan Reverse Proxy Rule ke IP Zeno Machine ini.
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" class="btn btn-secondary" onclick="closeMachineProxyModal()">Cancel</button>
                <button type="submit" class="btn btn-primary">Create Proxy Rule</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal ISO Library (Proxmox-style) -->
<div id="iso-library-modal" class="modal-backdrop" style="display: none; align-items: flex-start; justify-content: center; padding-top: 60px;">
    <div class="modal-content" style="max-width: 960px; width: 96%; background: #1a1f2e; border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; color: var(--text-main); overflow: hidden; box-shadow: 0 20px 60px rgba(0,0,0,0.6);">

        <!-- Header bar -->
        <div style="background: linear-gradient(135deg, #1e2538 0%, #252d40 100%); padding: 14px 20px; border-bottom: 1px solid rgba(255,255,255,0.08); display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <i class="fa-solid fa-database" style="color: #7dd3fc; font-size: 1rem;"></i>
                <span style="font-weight: 700; font-size: 1rem; color: var(--text-main);">ISO Images</span>
                <span style="font-size: 0.78rem; color: var(--text-muted); padding-left: 6px; border-left: 1px solid rgba(255,255,255,0.1);">Storage: local &mdash; /var/lib/zeno-container/isos</span>
            </div>
            <button onclick="closeIsoLibraryModal()" style="background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 1.1rem; padding: 2px 6px; border-radius: 4px;" onmouseover="this.style.color='var(--text-main)'" onmouseout="this.style.color='var(--text-muted)'">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <!-- Toolbar (Proxmox-style) -->
        <div style="padding: 10px 16px; background: rgba(15,20,35,0.5); border-bottom: 1px solid rgba(255,255,255,0.07); display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
            <!-- Upload button -->
            <button onclick="triggerIsoFileUpload()" style="background: rgba(30,41,59,0.8); border: 1px solid rgba(255,255,255,0.15); color: var(--text-main); padding: 6px 14px; border-radius: 5px; font-size: 0.82rem; cursor: pointer; display: flex; align-items: center; gap: 7px; font-weight: 500; transition: background 0.15s;" onmouseover="this.style.background='rgba(56,189,248,0.12)';this.style.borderColor='#38bdf8'" onmouseout="this.style.background='rgba(30,41,59,0.8)';this.style.borderColor='rgba(255,255,255,0.15)'">
                <i class="fa-solid fa-cloud-arrow-up" style="color: #38bdf8;"></i> Upload
            </button>
            <input type="file" id="iso-file-upload-input" accept=".iso,.img" style="display: none;" onchange="handleIsoFileUpload(event)">

            <!-- Download from URL button -->
            <button onclick="openIsoDownloadUrlDialog()" style="background: rgba(30,41,59,0.8); border: 1px solid rgba(255,255,255,0.15); color: var(--text-main); padding: 6px 14px; border-radius: 5px; font-size: 0.82rem; cursor: pointer; display: flex; align-items: center; gap: 7px; font-weight: 500; transition: background 0.15s;" onmouseover="this.style.background='rgba(167,139,250,0.12)';this.style.borderColor='#a78bfa'" onmouseout="this.style.background='rgba(30,41,59,0.8)';this.style.borderColor='rgba(255,255,255,0.15)'">
                <i class="fa-solid fa-link" style="color: #a78bfa;"></i> Download from URL
            </button>

            <!-- Remove button -->
            <button id="iso-remove-btn" onclick="deleteSelectedIso()" disabled style="background: rgba(30,41,59,0.8); border: 1px solid rgba(255,255,255,0.15); color: var(--text-muted); padding: 6px 14px; border-radius: 5px; font-size: 0.82rem; cursor: not-allowed; display: flex; align-items: center; gap: 7px; font-weight: 500; transition: all 0.15s;">
                <i class="fa-solid fa-trash"></i> Remove
            </button>

            <div style="flex: 1;"></div>

            <!-- Refresh -->
            <button onclick="loadIsoList()" style="background: none; border: 1px solid rgba(255,255,255,0.1); color: var(--text-muted); padding: 6px 10px; border-radius: 5px; font-size: 0.82rem; cursor: pointer;" title="Refresh" onmouseover="this.style.borderColor='rgba(255,255,255,0.3)'" onmouseout="this.style.borderColor='rgba(255,255,255,0.1)'">
                <i class="fa-solid fa-rotate-right"></i>
            </button>

            <!-- Search -->
            <div style="position: relative;">
                <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 9px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 0.75rem; pointer-events: none;"></i>
                <input type="text" id="iso-search-input" oninput="filterIsoTable(this.value)" placeholder="Name, Format" style="padding: 6px 10px 6px 28px; border-radius: 5px; border: 1px solid rgba(255,255,255,0.12); background: rgba(15,23,42,0.8); color: var(--text-main); font-size: 0.8rem; width: 190px; outline: none;">
            </div>
        </div>

        <!-- Upload progress (hidden by default) -->
        <div id="iso-upload-progress-container" style="display: none; padding: 8px 16px; background: rgba(56,189,248,0.06); border-bottom: 1px solid rgba(56,189,248,0.2);">
            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.78rem; margin-bottom: 5px;">
                <span id="iso-upload-progress-text" style="color: #38bdf8; font-weight: 600;"><i class="fa-solid fa-spinner fa-spin"></i> Uploading...</span>
                <span id="iso-upload-progress-percent" style="color: var(--text-main); font-weight: 700; font-family: monospace;">0%</span>
            </div>
            <div style="background: rgba(255,255,255,0.08); height: 5px; border-radius: 10px; overflow: hidden;">
                <div id="iso-upload-progress-bar" style="width: 0%; height: 100%; background: linear-gradient(90deg, #38bdf8, #818cf8); transition: width 0.3s ease;"></div>
            </div>
        </div>

        <!-- ISO File Table (Proxmox-style) -->
        <div style="max-height: 380px; overflow-y: auto;">
            <table style="width: 100%; border-collapse: collapse; font-size: 0.82rem;">
                <thead style="position: sticky; top: 0; z-index: 2;">
                    <tr style="background: rgba(15,20,35,0.95); border-bottom: 2px solid rgba(255,255,255,0.08);">
                        <th style="padding: 9px 14px; text-align: left; color: var(--text-muted); font-weight: 600; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; width: 36px;"></th>
                        <th style="padding: 9px 14px; text-align: left; color: var(--text-muted); font-weight: 600; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;">Name</th>
                        <th style="padding: 9px 14px; text-align: left; color: var(--text-muted); font-weight: 600; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; width: 90px;">Date</th>
                        <th style="padding: 9px 14px; text-align: left; color: var(--text-muted); font-weight: 600; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; width: 70px;">Format</th>
                        <th style="padding: 9px 14px; text-align: right; color: var(--text-muted); font-weight: 600; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; width: 90px;">Size</th>
                    </tr>
                </thead>
                <tbody id="iso-list-table-body">
                    <tr>
                        <td colspan="5" style="padding: 32px; text-align: center; color: var(--text-muted); font-size: 0.85rem;">
                            <i class="fa-solid fa-spinner fa-spin" style="margin-right: 8px;"></i> Loading...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Status bar (Proxmox-style footer) -->
        <div style="padding: 8px 16px; background: rgba(15,20,35,0.6); border-top: 1px solid rgba(255,255,255,0.07); display: flex; align-items: center; gap: 18px; font-size: 0.77rem; color: var(--text-muted);">
            <span><i class="fa-solid fa-compact-disc" style="margin-right: 5px; color: #7dd3fc;"></i>Total: <strong id="iso-stat-total" style="color: var(--text-main);">0</strong> files</span>
            <span><i class="fa-solid fa-circle-check" style="margin-right: 5px; color: #10b981;"></i>Ready: <strong id="iso-stat-ready" style="color: var(--text-main);">0</strong></span>
            <span><i class="fa-solid fa-link" style="margin-right: 5px; color: #f59e0b;"></i>Attached: <strong id="iso-stat-attached" style="color: var(--text-main);">0</strong></span>
            <div style="flex:1;"></div>
            <span id="iso-selected-info" style="display:none; color: #38bdf8;"></span>
        </div>
    </div>
</div>

<!-- Download from URL Dialog -->
<div id="iso-url-dialog" class="modal-backdrop" style="display: none; align-items: center; justify-content: center;">
    <div style="background: #1e2538; border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; padding: 24px; width: 480px; max-width: 95%;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px;">
            <h3 style="margin: 0; font-size: 1rem; font-weight: 700; display: flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-link" style="color: #a78bfa;"></i> Download from URL
            </h3>
            <button onclick="closeIsoDownloadUrlDialog()" style="background:none;border:none;color:var(--text-muted);cursor:pointer;font-size:1rem;"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div style="margin-bottom: 14px;">
            <label style="font-size: 0.78rem; color: var(--text-muted); font-weight: 600; display: block; margin-bottom: 6px;">URL</label>
            <input type="url" id="iso-download-url-input" placeholder="https://example.com/ubuntu-24.04.iso" style="width: 100%; box-sizing: border-box; padding: 9px 12px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.12); background: rgba(15,23,42,0.8); color: var(--text-main); font-size: 0.85rem; outline: none;">
        </div>
        <div style="margin-bottom: 18px;">
            <label style="font-size: 0.78rem; color: var(--text-muted); font-weight: 600; display: block; margin-bottom: 6px;">File Name (optional, auto-detected from URL)</label>
            <input type="text" id="iso-download-name-input" placeholder="ubuntu-24.04.iso" style="width: 100%; box-sizing: border-box; padding: 9px 12px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.12); background: rgba(15,23,42,0.8); color: var(--text-main); font-size: 0.85rem; outline: none;">
        </div>
        <div style="display: flex; justify-content: flex-end; gap: 8px;">
            <button onclick="closeIsoDownloadUrlDialog()" style="background: rgba(30,41,59,0.8); border: 1px solid rgba(255,255,255,0.15); color: var(--text-muted); padding: 8px 16px; border-radius: 6px; font-size: 0.82rem; cursor: pointer; font-weight: 500;">Cancel</button>
            <button onclick="submitIsoDownloadUrl()" style="background: linear-gradient(135deg, #7c3aed, #a78bfa); border: none; color: white; padding: 8px 20px; border-radius: 6px; font-size: 0.82rem; cursor: pointer; font-weight: 600;">
                <i class="fa-solid fa-cloud-arrow-down"></i> Download
            </button>
        </div>
    </div>
</div>


<!-- Modal Edit ISO Image -->

<div id="edit-iso-modal" class="modal-backdrop" style="display: none; align-items: center; justify-content: center;">
    <div class="modal-content" style="max-width: 500px; width: 95%; background: #0f172a; border: 1px solid rgba(236, 72, 153, 0.3); border-radius: 12px; padding: 24px; color: var(--text-main);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h3 style="margin: 0; font-size: 1.1rem; font-weight: 600; display: flex; align-items: center; gap: 8px; color: #ec4899;">
                <i class="fa-solid fa-pen-to-square"></i> Edit ISO Image Entry
            </h3>
            <button onclick="closeEditIsoModal()" style="background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 1.1rem;">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <form onsubmit="event.preventDefault(); submitEditIso();">
            <input type="hidden" id="edit-iso-id">
            <div class="form-group" style="margin-bottom: 14px;">
                <label style="display: block; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 6px; font-weight: 500;">ISO Name</label>
                <input type="text" id="edit-iso-name" required style="width: 100%; padding: 10px 12px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.12); background: rgba(30, 41, 59, 0.7); color: var(--text-main); font-size: 0.88rem;">
            </div>
            <div class="form-group" style="margin-bottom: 14px;">
                <label style="display: block; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 6px; font-weight: 500;">Local Path</label>
                <input type="text" id="edit-iso-path" required style="width: 100%; padding: 10px 12px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.12); background: rgba(30, 41, 59, 0.7); color: var(--text-main); font-size: 0.88rem;">
            </div>
            <div class="form-group" style="margin-bottom: 14px;">
                <label style="display: block; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 6px; font-weight: 500;">Download Source URL (Optional)</label>
                <input type="text" id="edit-iso-url" style="width: 100%; padding: 10px 12px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.12); background: rgba(30, 41, 59, 0.7); color: var(--text-main); font-size: 0.88rem;">
            </div>
            <div class="form-group" style="margin-bottom: 20px;">
                <label style="display: block; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 6px; font-weight: 500;">Status</label>
                <select id="edit-iso-status" style="width: 100%; padding: 10px 12px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.12); background: rgba(30, 41, 59, 0.7); color: var(--text-main); font-size: 0.88rem; cursor: pointer;">
                    <option value="ready">Ready (Available for VM)</option>
                    <option value="downloading">Downloading</option>
                    <option value="error">Error / Unavailable</option>
                </select>
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" class="btn btn-secondary" onclick="closeEditIsoModal()">Cancel</button>
                <button type="submit" class="btn btn-primary" style="background: #ec4899; border: none;">Save Changes</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Attach ISO to Zeno Machine -->
<div id="attach-iso-modal" class="modal-backdrop" style="display: none; align-items: center; justify-content: center;">
    <div class="modal-content" style="max-width: 480px; width: 95%; background: #0f172a; border: 1px solid rgba(56, 189, 248, 0.3); border-radius: 12px; padding: 24px; color: var(--text-main);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h3 style="margin: 0; font-size: 1.1rem; font-weight: 600; display: flex; align-items: center; gap: 8px; color: #38bdf8;">
                <i class="fa-solid fa-plug"></i> Attach ISO to Zeno Machine
            </h3>
            <button onclick="closeAttachIsoModal()" style="background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 1.1rem;">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <form onsubmit="event.preventDefault(); submitAttachIso();">
            <input type="hidden" id="attach-iso-target-path">
            <div class="form-group" style="margin-bottom: 16px;">
                <label style="display: block; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 6px; font-weight: 500;">Selected ISO Image</label>
                <input type="text" id="attach-iso-name-display" readonly style="width: 100%; padding: 10px 12px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.12); background: rgba(30, 41, 59, 0.4); color: #ec4899; font-weight: 600; font-size: 0.88rem;">
            </div>
            <div class="form-group" style="margin-bottom: 20px;">
                <label style="display: block; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 6px; font-weight: 500;">Target Zeno Machine</label>
                <select id="attach-iso-machine-select" required style="width: 100%; padding: 10px 12px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.12); background: rgba(30, 41, 59, 0.7); color: var(--text-main); font-size: 0.88rem; cursor: pointer;">
                    <option value="">-- Choose Zeno Machine --</option>
                </select>
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" class="btn btn-secondary" onclick="closeAttachIsoModal()">Cancel</button>
                <button type="submit" class="btn btn-primary" style="background: #38bdf8; border: none; color: #0f172a; font-weight: 600;">Attach ISO</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Snapshot Manager -->
<div id="snapshot-manager-modal" class="modal-backdrop" style="display: none; align-items: center; justify-content: center;">
    <div class="modal-content" style="max-width: 720px; width: 95%; background: #0f172a; border: 1px solid rgba(168, 85, 247, 0.3); border-radius: 14px; padding: 24px; color: var(--text-main);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h3 style="margin: 0; font-size: 1.15rem; font-weight: 600; display: flex; align-items: center; gap: 10px; color: #a855f7;">
                <i class="fa-solid fa-camera"></i> Snapshot Manager: <span id="snapshot-machine-title" style="color: #fff;">Machine</span>
            </h3>
            <button onclick="closeSnapshotManagerModal()" style="background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 1.1rem;">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <input type="hidden" id="snapshot-target-machine">

        <!-- Form Create Snapshot -->
        <form onsubmit="event.preventDefault(); submitCreateSnapshotModal();" style="background: rgba(30, 41, 59, 0.5); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 10px; padding: 16px; margin-bottom: 20px;">
            <div style="font-size: 0.88rem; font-weight: 600; margin-bottom: 12px; color: var(--text-main);">Take New Snapshot</div>
            <div style="display: grid; grid-template-columns: 1fr 1fr auto; gap: 10px; align-items: center;">
                <input type="text" id="snapshot-name-input" placeholder="Snapshot Name (e.g. pre-update-v1)" required style="padding: 9px 12px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.12); background: rgba(15, 23, 42, 0.7); color: var(--text-main); font-size: 0.85rem;">
                <input type="text" id="snapshot-desc-input" placeholder="Description (Optional)" style="padding: 9px 12px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.12); background: rgba(15, 23, 42, 0.7); color: var(--text-main); font-size: 0.85rem;">
                <button type="submit" class="btn btn-primary" style="background: #a855f7; border: none; padding: 9px 18px; font-weight: 600; border-radius: 6px; white-space: nowrap;">
                    <i class="fa-solid fa-camera"></i> Create Snapshot
                </button>
            </div>
        </form>

        <!-- Snapshots Table -->
        <div style="max-height: 260px; overflow-y: auto; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 8px;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.82rem;">
                <thead>
                    <tr style="background: rgba(15, 23, 42, 0.6); color: var(--text-muted); border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
                        <th style="padding: 10px 14px;">Snapshot Name</th>
                        <th style="padding: 10px 14px;">Description</th>
                        <th style="padding: 10px 14px;">Date</th>
                        <th style="padding: 10px 14px; text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody id="snapshot-list-table-body">
                    <tr>
                        <td colspan="4" style="padding: 20px; text-align: center; color: var(--text-muted);">
                            Loading snapshots...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div style="margin-top: 16px; text-align: right;">
            <button onclick="closeSnapshotManagerModal()" class="btn btn-secondary btn-sm">Close</button>
        </div>
    </div>
</div>

