<!-- WEBSITES TAB -->
<div class="viewport" id="tab-websites">
    <div class="card" style="margin-top:0;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
            <h3 style="margin:0; font-size:1.25rem; display:flex; align-items:center; gap:8px; font-family: var(--font-title);">
                <i class="fa-solid fa-earth-americas" style="color:var(--accent-primary);"></i> Websites
            </h3>
            <button class="btn-primary-action" onclick="openAddWebsiteModal()">
                <i class="fa-solid fa-plus"></i> Add Website
            </button>
        </div>
        
        <div class="table-container" style="min-height:300px;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Domain / Site Name</th>
                        <th>App Type</th>
                        <th>Host Port</th>
                        <th>Status</th>
                        <th style="text-align:left;">Actions</th>
                    </tr>
                </thead>
                <tbody id="websites-list-container">
                    <!-- Populated dynamically via websites.js -->
                </tbody>
            </table>
        </div>
    </div>
</div>
