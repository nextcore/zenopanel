# 6. File Manager - List Directory API
http.get: '/api/files/list' {
    auth.guard
    http.query: 'path' { as: $path_param }
    coalesce: $path_param {
        default: '.'
        as: $dir_path
    }
    try: {
        run: {
            io.exists: $dir_path { as: $exists }
            if: $exists {
                then: {
                    io.is_dir: $dir_path { as: $is_directory }
                    if: $is_directory {
                        then: {
                            system.dir_list: $dir_path { as: $files }
                            http.ok: {
                                data: $files
                                current_path: $dir_path
                            }
                        }
                        else: {
                            http.bad_request: {
                                success: false,
                                message: "Path bukan sebuah folder"
                            }
                        }
                    }
                }
                else: {
                    http.bad_request: {
                        success: false,
                        message: "Folder tidak ditemukan"
                    }
                }
            }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal membaca direktori: ${error}" }
        }
    }
}

# 7. File Manager - Read File API
http.get: '/api/files/read' {
    auth.guard
    http.query: 'path' { as: $file_path }
    try: {
        run: {
            io.exists: $file_path { as: $exists }
            if: $exists {
                then: {
                    io.is_dir: $file_path { as: $is_directory }
                    if: $is_directory {
                        then: {
                            http.bad_request: {
                                success: false,
                                message: "Path adalah sebuah folder, bukan file"
                            }
                        }
                        else: {
                            io.file.read: $file_path { as: $content }
                            http.ok: { content: $content }
                        }
                    }
                }
                else: {
                    http.bad_request: {
                        success: false,
                        message: "Berkas tidak ditemukan"
                    }
                }
            }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal membaca file: ${error}" }
        }
    }
}

# 8. File Manager - Write File API
http.post: '/api/files/write' {
    auth.guard
    http.json_body: { as: $body }
    var: $file_path { val: $body.path }
    var: $content { val: $body.content }
    try: {
        run: {
            io.file.write: {
                path: $file_path
                content: $content
            }
            http.ok: { message: "File berhasil disimpan" }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal menyimpan file: ${error}" }
        }
    }
}

# 9. File Manager - Create File/Folder API
http.post: '/api/files/create-file' {
    auth.guard
    http.json_body: { as: $body }
    var: $file_path { val: $body.path }
    try: {
        run: {
            io.file.write: {
                path: $file_path
                content: ""
            }
            http.ok: { message: "File berhasil dibuat" }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal membuat file: ${error}" }
        }
    }
}

# 9b. File Manager - Create Folder API
http.post: '/api/files/create-dir' {
    auth.guard
    http.json_body: { as: $body }
    var: $dir_path { val: $body.path }
    try: {
        run: {
            io.dir.create: $dir_path
            http.ok: { message: "Folder berhasil dibuat" }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal membuat folder: ${error}" }
        }
    }
}

# 10. File Manager - Delete File API
http.post: '/api/files/delete' {
    auth.guard
    http.json_body: { as: $body }
    var: $file_path { val: $body.path }
    try: {
        run: {
            io.file.delete: $file_path
            http.ok: { message: "File berhasil dihapus" }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal menghapus file: ${error}" }
        }
    }
}

# 10b. File Manager - Archive File/Folder API
http.post: '/api/files/archive' {
    auth.guard
    http.json_body: { as: $body }
    var: $src_path { val: $body.path }
    var: $dest_path { val: $body.dest }
    try: {
        run: {
            io.exists: $src_path { as: $exists }
            if: $exists {
                then: {
                    io.file.archive: {
                        path: $src_path
                        dest: $dest_path
                    }
                    http.ok: { message: "Archive berhasil dibuat" }
                }
                else: {
                    http.bad_request: {
                        success: false,
                        message: "Berkas atau folder sumber tidak ditemukan"
                    }
                }
            }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal membuat archive: ${error}" }
        }
    }
}

# 10c. File Manager - Extract Archive API
http.post: '/api/files/extract' {
    auth.guard
    http.json_body: { as: $body }
    var: $src_path { val: $body.path }
    var: $dest_path { val: $body.dest }
    try: {
        run: {
            io.exists: $src_path { as: $exists }
            if: $exists {
                then: {
                    io.file.extract: {
                        path: $src_path
                        dest: $dest_path
                    }
                    http.ok: { message: "Archive berhasil diekstrak" }
                }
                else: {
                    http.bad_request: {
                        success: false,
                        message: "Archive tidak ditemukan"
                    }
                }
            }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal mengekstrak archive: ${error}" }
        }
    }
}

# 10d. File Manager - Upload Files API
http.post: '/api/files/upload' {
    auth.guard
    auth.has_role: 'editor' { as: $is_editor }
    if: $is_editor {
        then: {
            try: {
                run: {
                    http.save_uploads: { as: $success }
                    if: $success {
                        then: {
                            http.ok: {
                                success: true,
                                message: "File uploaded successfully"
                            }
                        }
                        else: {
                            http.bad_request: {
                                success: false,
                                message: "Gagal mengunggah file"
                            }
                        }
                    }
                }
                catch: {
                    http.bad_request: { success: false, message: "Gagal mengunggah file: ${error}" }
                }
            }
        }
        else: {
            http.forbidden: {
                success: false,
                message: "Forbidden: Role Viewer tidak diijinkan mengupload file"
            }
        }
    }
}

# 10e. File Manager - Change Permissions API
http.post: '/api/files/chmod' {
    auth.guard
    http.json_body: { as: $body }
    var: $file_path { val: $body.path }
    var: $mode { val: $body.mode }
    coalesce: $body.recursive {
        default: false
        as: $recursive
    }
    try: {
        run: {
            io.exists: $file_path { as: $exists }
            if: $exists {
                then: {
                    io.file.chmod: {
                        path: $file_path
                        mode: $mode
                        recursive: $recursive
                    }
                    http.ok: { message: "Permissions berhasil diperbarui" }
                }
                else: {
                    http.bad_request: {
                        success: false,
                        message: "Berkas atau folder tidak ditemukan"
                    }
                }
            }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal merubah hak akses: ${error}" }
        }
    }
}

# 10f. File Manager - Download File API
http.get: '/api/files/download' {
    auth.guard
    http.query: 'path' { as: $file_path }
    try: {
        run: {
            http.download_file: { path: $file_path }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal mengunduh file: ${error}" }
        }
    }
}

# 10g. File Manager - Copy File/Folder API
http.post: '/api/files/copy' {
    auth.guard
    http.json_body: { as: $body }
    var: $src_path { val: $body.src }
    var: $dest_path { val: $body.dest }
    try: {
        run: {
            io.exists: $src_path { as: $exists }
            if: $exists {
                then: {
                    io.file.copy: {
                        src: $src_path
                        dest: $dest_path
                    }
                    http.ok: { message: "Item berhasil disalin" }
                }
                else: {
                    http.bad_request: {
                        success: false,
                        message: "Berkas atau folder sumber tidak ditemukan"
                    }
                }
            }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal menyalin item: ${error}" }
        }
    }
}

# 10h. File Manager - Move/Rename File/Folder API
http.post: '/api/files/move' {
    auth.guard
    http.json_body: { as: $body }
    var: $src_path { val: $body.src }
    var: $dest_path { val: $body.dest }
    try: {
        run: {
            io.exists: $src_path { as: $exists }
            if: $exists {
                then: {
                    io.file.move: {
                        src: $src_path
                        dest: $dest_path
                    }
                    http.ok: { message: "Item berhasil dipindahkan" }
                }
                else: {
                    http.bad_request: {
                        success: false,
                        message: "Berkas atau folder sumber tidak ditemukan"
                    }
                }
            }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal memindahkan item: ${error}" }
        }
    }
}
