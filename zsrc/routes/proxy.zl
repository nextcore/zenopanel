# 17. Reverse Proxy API
http.get: '/api/proxy/list' {
    auth.guard
    try: {
        run: {
            proxy.list: { as: $proxies }
            http.ok: { data: $proxies }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal mengambil daftar proxy: ${error}" }
        }
    }
}

http.post: '/api/proxy/add' {
    auth.guard
    http.json_body: { as: $body }
    coalesce: $body.domain {
        default: ''
        as: $clean_domain
    }
    coalesce: $body.alternative_domain {
        default: ''
        as: $clean_alternative_domain
    }
    coalesce: $body.path {
        default: '/'
        as: $clean_path
    }
    coalesce: $body.strip_path {
        default: false
        as: $clean_strip_path
    }
    coalesce: $body.enabled {
        default: true
        as: $clean_enabled
    }
    coalesce: $body.ssl_enabled {
        default: false
        as: $clean_ssl_enabled
    }
    coalesce: $body.managed_process_id {
        default: ''
        as: $clean_process_id
    }
    coalesce: $body.rule_type {
        default: 'proxy'
        as: $clean_rule_type
    }
    coalesce: $body.waf_enabled {
        default: true
        as: $clean_waf_enabled
    }
    coalesce: $body.max_body_size {
        default: 0
        as: $clean_max_body_size
    }

    try: {
        run: {
            proxy.add: $body.name {
                domain: $clean_domain
                alternative_domain: $clean_alternative_domain
                path: $clean_path
                target: $body.target
                strip_path: $clean_strip_path
                enabled: $clean_enabled
                ssl_enabled: $clean_ssl_enabled
                managed_process_id: $clean_process_id
                rule_type: $clean_rule_type
                waf_enabled: $clean_waf_enabled
                max_body_size: $clean_max_body_size
                as: $id
            }
            http.ok: {
                id: $id
                message: "Proxy rule berhasil ditambahkan"
            }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal menambahkan proxy rule: ${error}" }
        }
    }
}

http.post: '/api/proxy/update' {
    auth.guard
    http.json_body: { as: $body }
    coalesce: $body.domain {
        default: ''
        as: $clean_domain
    }
    coalesce: $body.alternative_domain {
        default: ''
        as: $clean_alternative_domain
    }
    coalesce: $body.path {
        default: '/'
        as: $clean_path
    }
    coalesce: $body.strip_path {
        default: false
        as: $clean_strip_path
    }
    coalesce: $body.enabled {
        default: true
        as: $clean_enabled
    }
    coalesce: $body.ssl_enabled {
        default: false
        as: $clean_ssl_enabled
    }
    coalesce: $body.managed_process_id {
        default: ''
        as: $clean_process_id
    }
    coalesce: $body.rule_type {
        default: 'proxy'
        as: $clean_rule_type
    }
    coalesce: $body.waf_enabled {
        default: true
        as: $clean_waf_enabled
    }
    coalesce: $body.max_body_size {
        default: 0
        as: $clean_max_body_size
    }
    coalesce: $body.ip_whitelist {
        default: ''
        as: $clean_ip_whitelist
    }
    coalesce: $body.ip_blacklist {
        default: ''
        as: $clean_ip_blacklist
    }

    try: {
        run: {
            proxy.update: $body.id {
                name: $body.name
                domain: $clean_domain
                alternative_domain: $clean_alternative_domain
                path: $clean_path
                target: $body.target
                strip_path: $clean_strip_path
                enabled: $clean_enabled
                ssl_enabled: $clean_ssl_enabled
                managed_process_id: $clean_process_id
                rule_type: $clean_rule_type
                waf_enabled: $clean_waf_enabled
                max_body_size: $clean_max_body_size
                ip_whitelist: $clean_ip_whitelist
                ip_blacklist: $clean_ip_blacklist
                as: $success
            }
            if: $success {
                then: {
                    http.ok: { message: "Proxy rule berhasil diperbarui" }
                }
                else: {
                    http.bad_request: { message: "Gagal memperbarui proxy rule" }
                }
            }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal memperbarui proxy rule: ${error}" }
        }
    }
}

http.post: '/api/proxy/delete' {
    auth.guard
    http.json_body: { as: $body }
    try: {
        run: {
            proxy.delete: $body.id { as: $success }
            if: $success {
                then: {
                    http.ok: { message: "Proxy rule berhasil dihapus" }
                }
                else: {
                    http.bad_request: { message: "Gagal menghapus proxy rule" }
                }
            }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal menghapus proxy rule: ${error}" }
        }
    }
}

http.post: '/api/proxy/toggle' {
    auth.guard
    http.json_body: { as: $body }
    try: {
        run: {
            proxy.toggle: $body.id {
                enabled: $body.enabled
                as: $success
            }
            if: $success {
                then: {
                    http.ok: { message: "Status proxy rule berhasil diubah" }
                }
                else: {
                    http.bad_request: { message: "Gagal mengubah status proxy rule" }
                }
            }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal mengubah status proxy rule: ${error}" }
        }
    }
}
