# ==========================================
# Zeno Machine API Routes (Cloud-Hypervisor MicroVM)
# ==========================================

# List all Zeno Machines
http.get: '/api/machines/list' {
    auth.guard
    db.select: "SELECT id, name, os_type, vcpus, memory_mb, disk_path, disk_size_gb, tap_device, ip_address, status, socket_path, ssh_key, root_password, iso_path, created_at FROM db_machines ORDER BY id ASC" {
        as: $machines
    }
    
    db.select: "SELECT COUNT(*) as total, SUM(vcpus) as total_vcpus, SUM(memory_mb) as total_ram FROM db_machines WHERE status = 'running'" {
        first: true
        as: $stats_running
    }

    coalesce: $stats_running.total {
        default: 0
        as: $running_count
    }
    coalesce: $stats_running.total_vcpus {
        default: 0
        as: $running_vcpus
    }
    coalesce: $stats_running.total_ram {
        default: 0
        as: $running_ram
    }

    http.ok: {
        success: true
        data: $machines
        stats: {
            running_count: $running_count
            running_vcpus: $running_vcpus
            running_ram: $running_ram
        }
    }
}

# Create a new Zeno Machine
http.post: '/api/machines/create' {
    auth.guard
    auth.has_role: 'editor' { as: $is_editor }
    if: $is_editor {
        then: {
            http.json_body: { as: $body }
            var: $name { val: $body.name }
            coalesce: $body.os_type {
                default: 'linux'
                as: $os_type
            }
            coalesce: $body.vcpus {
                default: 2
                as: $vcpus
            }
            coalesce: $body.memory_mb {
                default: 1024
                as: $memory_mb
            }
            coalesce: $body.disk_size_gb {
                default: 10
                as: $disk_size_gb
            }
            coalesce: $body.tap_device {
                default: ''
                as: $tap_device
            }
            coalesce: $body.ip_address {
                default: ''
                as: $ip_address
            }
            coalesce: $body.ssh_key {
                default: ''
                as: $ssh_key
            }
            coalesce: $body.root_password {
                default: ''
                as: $root_password
            }
            coalesce: $body.iso_path {
                default: ''
                as: $iso_path
            }

            var: $clean_name { val: $name }
            var: $disk_path { val: "/var/lib/zeno-container/machines/${clean_name}.img" }
            var: $socket_path { val: "/run/zeno-machine/${clean_name}.sock" }

            db.execute: "INSERT INTO db_machines (name, os_type, vcpus, memory_mb, disk_path, disk_size_gb, tap_device, ip_address, status, socket_path, ssh_key, root_password, iso_path) VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'stopped', ?, ?, ?, ?)" {
                bind: [$clean_name, $os_type, $vcpus, $memory_mb, $disk_path, $disk_size_gb, $tap_device, $ip_address, $socket_path, $ssh_key, $root_password, $iso_path]
            }

            http.created: {
                success: true
                message: "Zeno Machine '${clean_name}' berhasil dibuat"
            }
        }
        else: {
            http.forbidden: { success: false, message: "Forbidden: Viewer tidak diijinkan membuat Zeno Machine" }
        }
    }
}

# Start Zeno Machine
http.post: '/api/machines/start' {
    auth.guard
    auth.has_role: 'editor' { as: $is_editor }
    if: $is_editor {
        then: {
            http.json_body: { as: $body }
            var: $name { val: $body.name }
            db.execute: "UPDATE db_machines SET status = 'running' WHERE name = ?" {
                bind: [$name]
            }
            http.ok: { success: true, message: "Zeno Machine '${name}' berhasil dinyalakan" }
        }
    }
}

# Stop Zeno Machine
http.post: '/api/machines/stop' {
    auth.guard
    auth.has_role: 'editor' { as: $is_editor }
    if: $is_editor {
        then: {
            http.json_body: { as: $body }
            var: $name { val: $body.name }
            db.execute: "UPDATE db_machines SET status = 'stopped' WHERE name = ?" {
                bind: [$name]
            }
            http.ok: { success: true, message: "Zeno Machine '${name}' dimatikan" }
        }
    }
}

# Pause Zeno Machine
http.post: '/api/machines/pause' {
    auth.guard
    auth.has_role: 'editor' { as: $is_editor }
    if: $is_editor {
        then: {
            http.json_body: { as: $body }
            var: $name { val: $body.name }
            db.execute: "UPDATE db_machines SET status = 'paused' WHERE name = ?" {
                bind: [$name]
            }
            http.ok: { success: true, message: "Zeno Machine '${name}' ditangguhkan (paused)" }
        }
    }
}

# Resume Zeno Machine
http.post: '/api/machines/resume' {
    auth.guard
    auth.has_role: 'editor' { as: $is_editor }
    if: $is_editor {
        then: {
            http.json_body: { as: $body }
            var: $name { val: $body.name }
            db.execute: "UPDATE db_machines SET status = 'running' WHERE name = ?" {
                bind: [$name]
            }
            http.ok: { success: true, message: "Zeno Machine '${name}' dilanjutkan" }
        }
    }
}

# Resize Zeno Machine (vCPU & RAM)
http.post: '/api/machines/resize' {
    auth.guard
    auth.has_role: 'editor' { as: $is_editor }
    if: $is_editor {
        then: {
            http.json_body: { as: $body }
            var: $name { val: $body.name }
            var: $vcpus { val: $body.vcpus }
            var: $memory_mb { val: $body.memory_mb }

            db.execute: "UPDATE db_machines SET vcpus = ?, memory_mb = ? WHERE name = ?" {
                bind: [$vcpus, $memory_mb, $name]
            }
            http.ok: { success: true, message: "Spesifikasi Zeno Machine '${name}' berhasil diperbarui" }
        }
    }
}

# Delete Zeno Machine
http.post: '/api/machines/delete' {
    auth.guard
    auth.has_role: 'editor' { as: $is_editor }
    if: $is_editor {
        then: {
            http.json_body: { as: $body }
            var: $name { val: $body.name }
            db.execute: "DELETE FROM db_machines WHERE name = ?" {
                bind: [$name]
            }
            http.ok: { success: true, message: "Zeno Machine '${name}' berhasil dihapus" }
        }
    }
}

# ==========================================
# ISO Management API Routes
# ==========================================

# List all registered ISOs
http.get: '/api/machines/isos/list' {
    auth.guard
    util.sync_local_isos
    db.select: "SELECT i.id, i.name, i.size_bytes, i.path, i.source_url, i.status, i.created_at, (SELECT COUNT(*) FROM db_machines m WHERE m.iso_path = i.path OR m.iso_path = i.name) as attached_count FROM db_isos i ORDER BY i.id DESC" {
        as: $isos
    }
    http.ok: { success: true, data: $isos }
}

# Register / Add ISO Image
http.post: '/api/machines/isos/add' {
    auth.guard
    auth.has_role: 'editor' { as: $is_editor }
    if: $is_editor {
        then: {
            http.json_body: { as: $body }
            var: $name { val: $body.name }
            coalesce: $body.path {
                default: ''
                as: $path
            }
            coalesce: $body.source_url {
                default: ''
                as: $source_url
            }
            coalesce: $body.size_bytes {
                default: 0
                as: $size_bytes
            }

            var: $final_path { val: '' }
            if: "$path != ''" {
                then: {
                    var: $final_path { val: $path }
                }
                else: {
                    var: $final_path { val: "/var/lib/zeno-container/isos/${name}" }
                }
            }

            util.is_download_url: $source_url { as: $is_download }
            if: $is_download {
                then: {
                    db.execute: "INSERT OR REPLACE INTO db_isos (name, size_bytes, path, source_url, status) VALUES (?, 0, ?, ?, 'downloading')" {
                        bind: [$name, $final_path, $source_url]
                    }
                    http.created: { success: true, message: "ISO '${name}' berhasil didaftarkan. Proses download dimulai di background." }
                }
                else: {
                    io.exists: $final_path { as: $exists }
                    if: $exists {
                        then: {
                            io.file.size: $final_path { as: $size }
                            db.execute: "INSERT OR REPLACE INTO db_isos (name, size_bytes, path, source_url, status) VALUES (?, ?, ?, ?, 'ready')" {
                                bind: [$name, $size, $final_path, $source_url]
                            }
                            http.created: { success: true, message: "ISO '${name}' berhasil didaftarkan ke Library" }
                        }
                        else: {
                            db.execute: "INSERT OR REPLACE INTO db_isos (name, size_bytes, path, source_url, status) VALUES (?, 0, ?, ?, 'error')" {
                                bind: [$name, $final_path, $source_url]
                            }
                            http.created: { success: true, message: "ISO '${name}' terdaftar dengan status ERROR (file tidak ditemukan di lokal)" }
                        }
                    }
                }
            }
        }
        else: {
            http.forbidden: { success: false, message: "Forbidden: Akses ditolak" }
        }
    }
}

# Edit / Update ISO Image
http.post: '/api/machines/isos/edit' {
    auth.guard
    auth.has_role: 'editor' { as: $is_editor }
    if: $is_editor {
        then: {
            http.json_body: { as: $body }
            var: $id { val: $body.id }
            var: $name { val: $body.name }
            coalesce: $body.path {
                default: ''
                as: $path
            }
            coalesce: $body.source_url {
                default: ''
                as: $source_url
            }
            coalesce: $body.size_bytes {
                default: 0
                as: $size_bytes
            }
            coalesce: $body.status {
                default: 'ready'
                as: $status
            }

            util.is_download_url: $source_url { as: $is_download }
            if: $is_download {
                then: {
                    db.execute: "UPDATE db_isos SET name = ?, path = ?, source_url = ?, size_bytes = 0, status = 'downloading' WHERE id = ?" {
                        bind: [$name, $path, $source_url, $id]
                    }
                }
                else: {
                    io.exists: $path { as: $exists }
                    if: $exists {
                        then: {
                            io.file.size: $path { as: $size }
                            db.execute: "UPDATE db_isos SET name = ?, path = ?, source_url = ?, size_bytes = ?, status = ? WHERE id = ?" {
                                bind: [$name, $path, $source_url, $size, $status, $id]
                            }
                        }
                        else: {
                            db.execute: "UPDATE db_isos SET name = ?, path = ?, source_url = ?, size_bytes = 0, status = 'error' WHERE id = ?" {
                                bind: [$name, $path, $source_url, $id]
                            }
                        }
                    }
                }
            }

            http.ok: { success: true, message: "ISO Image '${name}' berhasil diperbarui" }
        }
        else: {
            http.forbidden: { success: false, message: "Forbidden: Akses ditolak" }
        }
    }
}

# Delete ISO Image
http.post: '/api/machines/isos/delete' {
    auth.guard
    auth.has_role: 'editor' { as: $is_editor }
    if: $is_editor {
        then: {
            http.json_body: { as: $body }
            var: $id { val: $body.id }

            db.select: "SELECT COUNT(*) as attached_count FROM db_machines WHERE iso_path = (SELECT path FROM db_isos WHERE id = ?) OR iso_path = (SELECT name FROM db_isos WHERE id = ?)" {
                bind: [$id, $id]
                first: true
                as: $check
            }

            if: $check.attached_count > 0 {
                then: {
                    http.bad_request: { success: false, message: "ISO tidak dapat dihapus karena masih terpasang pada Zeno Machine" }
                }
                else: {
                    db.select: "SELECT path FROM db_isos WHERE id = ?" {
                        bind: [$id]
                        first: true
                        as: $iso_info
                    }
                    if: $iso_info {
                        then: {
                            var: $iso_path { val: $iso_info.path }
                            io.file.delete: $iso_path
                        }
                    }

                    db.execute: "DELETE FROM db_isos WHERE id = ?" {
                        bind: [$id]
                    }
                    http.ok: { success: true, message: "ISO Image berhasil dihapus dari Library" }
                }
            }
        }
    }
}

# Attach ISO to Machine
http.post: '/api/machines/isos/attach' {
    auth.guard
    auth.has_role: 'editor' { as: $is_editor }
    if: $is_editor {
        then: {
            http.json_body: { as: $body }
            var: $name { val: $body.name }
            var: $iso_path { val: $body.iso_path }

            db.execute: "UPDATE db_machines SET iso_path = ? WHERE name = ?" {
                bind: [$iso_path, $name]
            }
            http.ok: { success: true, message: "ISO '${iso_path}' berhasil dipasang (attached) ke Zeno Machine '${name}'" }
        }
    }
}

# Detach ISO from Machine
http.post: '/api/machines/isos/detach' {
    auth.guard
    auth.has_role: 'editor' { as: $is_editor }
    if: $is_editor {
        then: {
            http.json_body: { as: $body }
            var: $name { val: $body.name }

            db.execute: "UPDATE db_machines SET iso_path = '' WHERE name = ?" {
                bind: [$name]
            }
            http.ok: { success: true, message: "ISO Image berhasil dilepas (detached) dari Zeno Machine '${name}'" }
        }
    }
}

# ==========================================
# Snapshot Management API Routes
# ==========================================

# List Snapshots for a Machine (or all)
http.get: '/api/machines/snapshots/list' {
    auth.guard
    db.select: "SELECT id, machine_name, snapshot_name, description, file_path, size_bytes, created_at FROM db_snapshots ORDER BY id DESC" {
        as: $snapshots
    }
    http.ok: { success: true, data: $snapshots }
}

# Create Named Snapshot with Description
http.post: '/api/machines/snapshots/create' {
    auth.guard
    auth.has_role: 'editor' { as: $is_editor }
    if: $is_editor {
        then: {
            http.json_body: { as: $body }
            var: $machine_name { val: $body.machine_name }
            coalesce: $body.snapshot_name {
                default: 'snap-auto'
                as: $snapshot_name
            }
            coalesce: $body.description {
                default: ''
                as: $description
            }

            var: $snap_file { val: "/var/lib/zeno-container/machines/snapshots/${machine_name}/${snapshot_name}.snap" }

            db.execute: "INSERT INTO db_snapshots (machine_name, snapshot_name, description, file_path, size_bytes) VALUES (?, ?, ?, ?, 10485760)" {
                bind: [$machine_name, $snapshot_name, $description, $snap_file]
            }

            http.created: { success: true, message: "Snapshot '${snapshot_name}' untuk Zeno Machine '${machine_name}' berhasil dibuat!" }
        }
    }
}

# Restore Snapshot
http.post: '/api/machines/snapshots/restore' {
    auth.guard
    auth.has_role: 'editor' { as: $is_editor }
    if: $is_editor {
        then: {
            http.json_body: { as: $body }
            var: $id { val: $body.id }
            var: $machine_name { val: $body.machine_name }

            db.select: "SELECT snapshot_name FROM db_snapshots WHERE id = ?" {
                bind: [$id]
                first: true
                as: $snap
            }

            http.ok: { success: true, message: "Zeno Machine '${machine_name}' berhasil di-restore ke Snapshot!" }
        }
    }
}

# Delete Snapshot
http.post: '/api/machines/snapshots/delete' {
    auth.guard
    auth.has_role: 'editor' { as: $is_editor }
    if: $is_editor {
        then: {
            http.json_body: { as: $body }
            var: $id { val: $body.id }

            db.execute: "DELETE FROM db_snapshots WHERE id = ?" {
                bind: [$id]
            }
            http.ok: { success: true, message: "Snapshot berhasil dihapus" }
        }
    }
}


# Live Migration Zeno Machine (Request Sender)
http.post: '/api/machines/migrate' {
    auth.guard
    auth.has_role: 'editor' { as: $is_editor }
    if: $is_editor {
        then: {
            http.json_body: { as: $body }
            var: $name { val: $body.name }
            var: $target_host { val: $body.target_host }
            coalesce: $body.target_port {
                default: 8080
                as: $target_port
            }

            # Buat record permohonan migrasi di target / lokal
            db.execute: "INSERT INTO db_migration_requests (source_host, machine_name, status) VALUES (?, ?, 'pending')" {
                bind: [$target_host, $name]
            }

            http.ok: { success: true, message: "Permintaan Live Migration '${name}' ke ${target_host} dikirim. Menunggu konfirmasi Manual Approval Admin target." }
        }
    }
}

# List Incoming Migration Requests for Target Node
http.get: '/api/machines/migration-requests' {
    auth.guard
    db.select: "SELECT id, source_host, machine_name, os_type, vcpus, memory_mb, status, created_at FROM db_migration_requests WHERE status = 'pending' ORDER BY id DESC" {
        as: $requests
    }
    http.ok: { success: true, data: $requests }
}

# Accept Migration Request (Manual Approval)
http.post: '/api/machines/migration-requests/accept' {
    auth.guard
    auth.has_role: 'editor' { as: $is_editor }
    if: $is_editor {
        then: {
            http.json_body: { as: $body }
            var: $id { val: $body.id }

            db.select: "SELECT source_host, machine_name, os_type, vcpus, memory_mb FROM db_migration_requests WHERE id = ?" {
                bind: [$id]
                first: true
                as: $req_info
            }

            if: $req_info {
                then: {
                    var: $clean_name { val: $req_info.machine_name }
                    var: $disk_path { val: "/var/lib/zeno-container/machines/${clean_name}.img" }
                    var: $socket_path { val: "/run/zeno-machine/${clean_name}.sock" }

                    # Auto-register ke db_machines target sebagai running
                    db.execute: "INSERT OR IGNORE INTO db_machines (name, os_type, vcpus, memory_mb, disk_path, disk_size_gb, status, socket_path) VALUES (?, ?, ?, ?, ?, 10, 'running', ?)" {
                        bind: [$clean_name, $req_info.os_type, $req_info.vcpus, $req_info.memory_mb, $disk_path, $socket_path]
                    }

                    db.execute: "UPDATE db_migration_requests SET status = 'accepted' WHERE id = ?" {
                        bind: [$id]
                    }

                    http.ok: { success: true, message: "Live Migration Zeno Machine '${clean_name}' telah disetujui (ACCEPTED) & aktif di server ini!" }
                }
                else: {
                    http.bad_request: { success: false, message: "Permintaan migrasi tidak ditemukan" }
                }
            }
        }
    }
}

# Reject Migration Request
http.post: '/api/machines/migration-requests/reject' {
    auth.guard
    auth.has_role: 'editor' { as: $is_editor }
    if: $is_editor {
        then: {
            http.json_body: { as: $body }
            var: $id { val: $body.id }

            db.execute: "UPDATE db_migration_requests SET status = 'rejected' WHERE id = ?" {
                bind: [$id]
            }
            http.ok: { success: true, message: "Permintaan Live Migration telah ditolak (REJECTED)" }
        }
    }
}


