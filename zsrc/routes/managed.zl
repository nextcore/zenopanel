# 16. Managed Processes API
http.get: '/api/managed/list' {
    auth.guard
    try: {
        run: {
            proc.list: { as: $procs }
            http.ok: { data: $procs }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal mengambil daftar proses managed: ${error}" }
        }
    }
}

http.post: '/api/managed/add' {
    auth.guard
    http.json_body: { as: $body }
    coalesce: $body.env {
        default: {}
        as: $clean_env
    }
    coalesce: $body.auto_restart {
        default: true
        as: $clean_auto_restart
    }

    try: {
        run: {
            proc.add: $body.name {
                command: $body.command
                cwd: $body.cwd
                env: $clean_env
                auto_restart: $clean_auto_restart
                port: $body.port
                as: $id
            }
            http.ok: {
                id: $id
                message: "Proses managed berhasil ditambahkan"
            }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal menambahkan proses managed: ${error}" }
        }
    }
}

http.post: '/api/managed/update' {
    auth.guard
    http.json_body: { as: $body }
    coalesce: $body.env {
        default: {}
        as: $clean_env
    }
    coalesce: $body.auto_restart {
        default: true
        as: $clean_auto_restart
    }

    try: {
        run: {
            proc.update: $body.id {
                name: $body.name
                command: $body.command
                cwd: $body.cwd
                env: $clean_env
                auto_restart: $clean_auto_restart
                port: $body.port
                as: $success
            }
            if: $success {
                then: {
                    http.ok: { message: "Proses managed berhasil diperbarui" }
                }
                else: {
                    http.bad_request: { message: "Gagal memperbarui proses managed" }
                }
            }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal memperbarui proses managed: ${error}" }
        }
    }
}

http.post: '/api/managed/start' {
    auth.guard
    http.json_body: { as: $body }
    try: {
        run: {
            proc.start: $body.id { as: $success }
            if: $success {
                then: {
                    http.ok: { message: "Proses managed berhasil dijalankan" }
                }
                else: {
                    http.bad_request: { message: "Gagal menjalankan proses managed" }
                }
            }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal menjalankan proses managed: ${error}" }
        }
    }
}

http.post: '/api/managed/stop' {
    auth.guard
    http.json_body: { as: $body }
    try: {
        run: {
            proc.stop: $body.id { as: $success }
            if: $success {
                then: {
                    http.ok: { message: "Proses managed berhasil dihentikan" }
                }
                else: {
                    http.bad_request: { message: "Gagal menghentikan proses managed" }
                }
            }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal menghentikan proses managed: ${error}" }
        }
    }
}

http.post: '/api/managed/restart' {
    auth.guard
    http.json_body: { as: $body }
    try: {
        run: {
            proc.restart: $body.id { as: $success }
            if: $success {
                then: {
                    http.ok: { message: "Proses managed berhasil direstart" }
                }
                else: {
                    http.bad_request: { message: "Gagal merestart proses managed" }
                }
            }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal merestart proses managed: ${error}" }
        }
    }
}

http.post: '/api/managed/delete' {
    auth.guard
    http.json_body: { as: $body }
    try: {
        run: {
            proc.delete: $body.id { as: $success }
            if: $success {
                then: {
                    http.ok: { message: "Proses managed berhasil dihapus" }
                }
                else: {
                    http.bad_request: { message: "Gagal menghapus proses managed" }
                }
            }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal menghapus proses managed: ${error}" }
        }
    }
}

http.get: '/api/managed/logs' {
    auth.guard
    http.query: 'id' { as: $proc_id }
    http.query: 'lines' { as: $lines_param }
    coalesce: $lines_param {
        default: '100'
        as: $lines_str
    }
    try: {
        run: {
            cast.to_int: $lines_str { as: $lines }
            proc.logs: $proc_id {
                lines: $lines
                as: $logs
            }
            http.ok: { data: $logs }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal mengambil log proses managed: ${error}" }
        }
    }
}

# Get Git Settings for Native Managed Process
http.get: '/api/managed/git' {
    auth.guard
    http.query: 'cwd' { as: $cwd }
    try: {
        run: {
            proc.git_get: {
                cwd: $cwd
                as: $result
            }
            http.ok: { data: $result }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal mengambil pengaturan Git: ${error}" }
        }
    }
}

# Save Git Settings for Native Managed Process
http.post: '/api/managed/git' {
    auth.guard
    http.json_body: { as: $body }
    try: {
        run: {
            proc.git_save: {
                cwd: $body.cwd
                repo_url: $body.repo_url
                branch: $body.branch
                webhook_token: $body.webhook_token
                as: $success
            }
            if: $success {
                then: {
                    http.ok: { message: "Git settings saved successfully" }
                }
                else: {
                    http.bad_request: { message: "Failed to save Git settings" }
                }
            }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal menyimpan pengaturan Git: ${error}" }
        }
    }
}

# Trigger Git Sync for Native Managed Process
http.post: '/api/managed/git/sync' {
    auth.guard
    http.json_body: { as: $body }
    try: {
        run: {
            proc.git_sync: {
                id: $body.id
                as: $result
            }
            if: $result.success {
                then: {
                    http.ok: { output: $result.stdout }
                }
                else: {
                    http.bad_request: {
                        message: "Git sync failed"
                        error: $result.stderr
                    }
                }
            }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal menyelaraskan Git: ${error}" }
        }
    }
}

# Public Webhook Auto-Deploy for Native Managed Process
http.post: '/api/deploy/native' {
    http.query: 'id' { as: $proc_id }
    http.query: 'token' { as: $token_query }
    try: {
        run: {
            proc.git_sync: {
                id: $proc_id
                token: $token_query
                as: $sync_res
            }

            if: $sync_res.success {
                then: {
                    http.ok: { message: "Auto-deployment triggered successfully via webhook", output: $sync_res.stdout }
                }
                else: {
                    http.bad_request: { message: "Webhook sync failed", error: $sync_res.stderr }
                }
            }
        }
        catch: {
            http.bad_request: { success: false, message: "Webhook deployment error: ${error}" }
        }
    }
}
