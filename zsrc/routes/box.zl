        }
        catch: {
            http.bad_request: { success: false, message: "Gagal mendapatkan path RootFS: ${error}" }
        }
    }
}

# ─── Update Container Resources ──────────────────────────────────
http.post: '/api/box/update' {
    auth.guard
    http.json_body: { as: $body }
    try: {
        run: {
            box.update: $body.id {
                memory: $body.memory
