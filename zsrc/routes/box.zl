            if: $result.success {
                then: {
                    http.ok: { message: "Container resources updated successfully" }
                }
                else: {
                    http.bad_request: {
                        message: "Failed to update container resources"
                        error: $result.stderr
                    }
                }
            }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal memperbarui sumber daya kontainer: ${error}" }
        }
    }
}

