# Zeno-Box Native Container Management API
# Menggunakan native box slots (runc + Rust) untuk mengelola container

# ─── List Containers ──────────────────────────────────────────────
http.get: '/api/box/list' {
    auth.guard
    try: {
        run: {
            box.list: { as: $containers }
            http.ok: { data: $containers }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal mengambil daftar kontainer: ${error}" }
        }
    }
}

# ─── List Cached Images ──────────────────────────────────────────
http.get: '/api/box/images' {
    auth.guard
    try: {
        run: {
            box.images: { as: $images }
            http.ok: { data: $images }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal mengambil daftar images: ${error}" }
        }
    }
}

# ─── Pull Image ─────────────────────────────────────────────────
http.post: '/api/box/pull' {
    auth.guard
    http.json_body: { as: $body }
    try: {
        run: {
            box.pull: $body.image { as: $result }
            if: $result.success {
                then: {
                    http.ok: { message: "Image pulled successfully" }
                }
                else: {
                    http.bad_request: {
                        message: "Failed to pull image"
                        error: $result.stderr
                    }
                }
            }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal menarik image: ${error}" }
        }
    }
}

# ─── Create Container ──────────────────────────────────────────
http.post: '/api/box/create' {
    auth.guard
    http.json_body: { as: $body }
    try: {
        run: {
            box.create: {
                name: $body.name
                image: $body.image
                cmd: $body.cmd
                ports: $body.ports
                volumes: $body.volumes
                env: $body.env
                host_net: $body.host_net
                memory: $body.memory
                cpus: $body.cpus
                oom_score_adj: $body.oom_score_adj
                read_only: $body.read_only
                as: $result
            }

            if: $result.success {
                then: {
                    coalesce: $body.proxy_domain {
                        default: ''
                        as: $proxy_domain
                    }
                    if: $proxy_domain != '' {
                        then: {
                            proxy.add: $body.name {
                                domain: $proxy_domain
                                path: '/'
                                target: $body.target
                                strip_path: false
                                enabled: true
                                ssl_enabled: false
                                rule_type: 'proxy'
                                managed_process_id: $body.name
                                as: $proxy_result
                            }
                            http.created: {
                                message: "Container created with proxy rule"
                                id: $body.name
                                proxy_created: true
                            }
                        }
                        else: {
                            http.created: {
                                message: "Container created successfully"
                                id: $body.name
                            }
                        }
                    }
                }
                else: {
                    http.bad_request: {
                        message: "Failed to create container"
                        error: $result.stderr
                    }
                }
            }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal membuat kontainer: ${error}" }
        }
    }
}

# ─── Start Container ───────────────────────────────────────────
http.post: '/api/box/start' {
    auth.guard
    http.json_body: { as: $body }
    try: {
        run: {
            box.start: $body.id {
                as: $result
            }
            if: $result.success {
                then: {
                    http.ok: { message: "Container started" }
                }
                else: {
                    http.bad_request: {
                        message: "Failed to start container"
                        error: $result.stderr
                    }
                }
            }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal menyalakan kontainer: ${error}" }
        }
    }
}

# ─── Stop Container ────────────────────────────────────────────
http.post: '/api/box/stop' {
    auth.guard
    http.json_body: { as: $body }
    try: {
        run: {
            box.stop: $body.id {
                as: $result
            }
            if: $result.success {
                then: {
                    http.ok: { message: "Container stopped" }
                }
                else: {
                    http.bad_request: {
                        message: "Failed to stop container"
                        error: $result.stderr
                    }
                }
            }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal menghentikan kontainer: ${error}" }
        }
    }
}

# ─── Delete Container ──────────────────────────────────────────
http.post: '/api/box/delete' {
    auth.guard
    http.json_body: { as: $body }
    try: {
        run: {
            box.delete: $body.id {
                as: $result
            }
            if: $result.success {
                then: {
                    http.ok: { message: "Container removed" }
                }
                else: {
                    http.bad_request: {
                        message: "Failed to remove container"
                        error: $result.stderr
                    }
                }
            }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal menghapus kontainer: ${error}" }
        }
    }
}

# ─── Inspect Container ─────────────────────────────────────────
http.get: '/api/box/inspect' {
    auth.guard
    http.query: 'id' { as: $container_id }
    try: {
        run: {
            box.inspect: $container_id {
                as: $result
            }
            if: $result.success {
                then: {
                    http.ok: { data: $result.stdout }
                }
                else: {
                    http.bad_request: {
                        message: "Container not found"
                        error: $result.stderr
                    }
                }
            }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal menginspeksi kontainer: ${error}" }
        }
    }
}

# ─── Container Logs ────────────────────────────────────────────
http.get: '/api/box/logs' {
    auth.guard
    http.query: 'id' { as: $container_id }
    try: {
        run: {
            box.logs: $container_id {
                as: $result
            }
            if: $result.success {
                then: {
                    http.ok: { data: $result.stdout }
                }
                else: {
                    http.ok: { data: 'No logs available' }
                }
            }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal mengambil log kontainer: ${error}" }
        }
    }
}

