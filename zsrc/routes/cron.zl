# ==========================================
# Cron Jobs Management API
# ==========================================

# 1. GET /api/cron/list
http.get: '/api/cron/list' {
    auth.guard
    try: {
        run: {
            db.select: "SELECT id, name, schedule, command, is_active, last_run FROM cron_jobs ORDER BY id DESC" { as: $jobs }
            http.ok: { data: $jobs }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal mengambil daftar cron job: ${error}" }
        }
    }
}

# 2. POST /api/cron/create
http.post: '/api/cron/create' {
    auth.guard
    http.json_body: { as: $body }
    var: $name { val: $body.name }
    var: $schedule { val: $body.schedule }
    var: $command { val: $body.command }

    try: {
        run: {
            db.execute: "INSERT INTO cron_jobs (name, schedule, command, is_active) VALUES (?, ?, ?, 1)" {
                bind: [$name, $schedule, $command]
            }
            
            # Sync with /etc/cron.d/zenopanel
            system.cron_sync: { as: $sync_success }
            
            http.created: { success: true, message: "Cron job created successfully" }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal membuat cron job: ${error}" }
        }
    }
}

# 3. POST /api/cron/toggle
http.post: '/api/cron/toggle' {
    auth.guard
    http.json_body: { as: $body }
    var: $id { val: $body.id }
    var: $is_active { val: $body.is_active }

    try: {
        run: {
            db.execute: "UPDATE cron_jobs SET is_active = ? WHERE id = ?" {
                bind: [$is_active, $id]
            }

            # Sync with /etc/cron.d/zenopanel
            system.cron_sync: { as: $sync_success }

            http.ok: { success: true, message: "Cron job status updated successfully" }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal mengubah status cron job: ${error}" }
        }
    }
}

# 4. POST /api/cron/delete
http.post: '/api/cron/delete' {
    auth.guard
    http.json_body: { as: $body }
    var: $id { val: $body.id }

    try: {
        run: {
            db.execute: "DELETE FROM cron_jobs WHERE id = ?" {
                bind: [$id]
            }

            # Sync with /etc/cron.d/zenopanel
            system.cron_sync: { as: $sync_success }

            http.ok: { success: true, message: "Cron job deleted successfully" }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal menghapus cron job: ${error}" }
        }
    }
}

# 5. POST /api/cron/run
http.post: '/api/cron/run' {
    auth.guard
    http.json_body: { as: $body }
    var: $id { val: $body.id }

    try: {
        run: {
            db.select: "SELECT name, command FROM cron_jobs WHERE id = ?" {
                bind: [$id]
                first: true
                as: $job
            }

            if: $job {
                then: {
                    var: $command { val: $job.command }
                    system.exec: $command { as: $exec_res }
                    
                    # Update last run timestamp
                    db.execute: "UPDATE cron_jobs SET last_run = CURRENT_TIMESTAMP WHERE id = ?" {
                        bind: [$id]
                    }

                    http.ok: {
                        success: true
                        message: "Cron job executed successfully"
                        stdout: $exec_res.stdout
                        stderr: $exec_res.stderr
                        exit_code: $exec_res.exit_code
                    }
                }
                else: {
                    http.bad_request: { message: "Cron job not found" }
                }
            }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal menjalankan cron job secara manual: ${error}" }
        }
    }
}
