# Container Management API
# Menggunakan zeno-container CLI untuk mengelola container via runc

# ─── List Containers ──────────────────────────────────────────────
http.get: '/api/containers/list' {
    auth.guard
    try: {
        run: {
            box.list: { as: $containers }
            http.ok: { data: $containers }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal mengambil daftar kontainer: ${error}" }
        }
    }
}

# ─── Fetch Docker Hub Tags ───────────────────────────────────────
http.get: '/api/containers/docker-tags' {
    auth.guard
    http.query: 'repo' { as: $repo }
    try: {
        run: {
            system.fetch_docker_tags: { repo: $repo, as: $tags }
            http.ok: { data: $tags }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal mengambil tag Docker: ${error}" }
        }
    }
}

# ─── Search Docker Hub ───────────────────────────────────────────
http.get: '/api/containers/docker-search' {
    auth.guard
    http.query: 'q' { as: $q }
    try: {
        run: {
            system.docker_search: { query: $q, limit: 15, as: $results }
            http.ok: { data: $results }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal mencari di Docker Hub: ${error}" }
        }
    }
}

# ─── List Cached Images ──────────────────────────────────────────
http.get: '/api/containers/images' {
    auth.guard
    try: {
        run: {
            box.images: { as: $images }
            http.ok: { data: $images }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal mengambil daftar images: ${error}" }
        }
    }
}

# ─── Pull Image ─────────────────────────────────────────────────
http.post: '/api/containers/pull' {
    auth.guard
    http.json_body: { as: $body }
    try: {
        run: {
            box.pull: $body.image { as: $result }
            if: $result.success {
                then: {
                    http.ok: { message: "Image pulled successfully" }
                }
                else: {
                    http.bad_request: {
                        message: "Failed to pull image"
                        error: $result.stderr
                    }
                }
            }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal menarik image: ${error}" }
        }
    }
}

# ─── Create Container ──────────────────────────────────────────
http.post: '/api/containers/create' {
    auth.guard
    http.json_body: { as: $body }
    try: {
        run: {
            box.create: {
                name: $body.name
                image: $body.image
                cmd: $body.cmd
                ports: $body.ports
                volumes: $body.volumes
                env: $body.env
                host_net: $body.host_net
                memory: $body.memory
                cpus: $body.cpus
                oom_score_adj: $body.oom_score_adj
                read_only: $body.read_only
                as: $result
            }

            if: $result.success {
                then: {
                    coalesce: $body.proxy_domain {
                        default: ''
                        as: $proxy_domain
                    }
                    if: $proxy_domain != '' {
                        then: {
                            proxy.add: $body.name {
                                domain: $proxy_domain
                                path: '/'
                                target: $body.target
                                strip_path: false
                                enabled: true
                                ssl_enabled: false
                                rule_type: 'proxy'
                                managed_process_id: $body.name
                                as: $proxy_result
                            }
                            http.created: {
                                message: "Container created with proxy rule"
                                id: $body.name
                                proxy_created: true
                            }
                        }
                        else: {
                            http.created: {
                                message: "Container created successfully"
                                id: $body.name
                            }
                        }
                    }
                }
                else: {
                    http.bad_request: {
                        message: "Failed to create container"
                        error: $result.stderr
                    }
                }
            }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal membuat kontainer: ${error}" }
        }
    }
}

# ─── Add Proxy Rule for Container ───────────────────────────────
http.post: '/api/containers/add-proxy' {
    auth.guard
    http.json_body: { as: $body }
    try: {
        run: {
            proxy.add: $body.name {
                domain: $body.domain
                alternative_domain: ''
                path: '/'
                target: $body.target
                strip_path: false
                enabled: true
                ssl_enabled: false
                rule_type: 'proxy'
                managed_process_id: $body.container_id
                as: $proxy_result
            }

            if: $proxy_result {
                then: {
                    http.created: {
                        message: "Proxy rule created for container"
                        target: $body.target
                    }
                }
                else: {
                    http.bad_request: {
                        message: "Failed to create proxy rule"
                    }
                }
            }
        }
        catch: {
            http.bad_request: { success: false, message: "Gagal menambahkan proxy rule: ${error}" }
        }
    }
}

# ─── Start Container ───────────────────────────────────────────
http.post: '/api/containers/start' {
    auth.guard
    http.json_body: { as: $body }
    try: {
        run: {
